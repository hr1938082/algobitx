{
  "name": "@algobitx/source",
  "version": "1.0.0",
  "description": "algobitx source code",
  "author": "algobitx",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/**",
    "packages/**"
  ],
  "scripts": {
    "clean": "pnpm -r run clean && rimraf node_modules",
    "clean-install": "pnpm clean && rimraf pnpm-lock.yaml && pnpm install",
    "build": "pnpm -r run build  && pnpm install",
    "bundle": "pnpm install --frozen-lockfile && pnpm -r run bundle",
    "clean-build": "pnpm clean-install && pnpm build",
    "clean-build-bundle": "pnpm clean-build && pnpm bundle",
    "safty-web-server": "pnpm --filter @algobitx/safty-web-server dev",
    "safty-web-clinet": "pnpm --filter @algobitx/safty-web-client dev"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  },
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d"
}