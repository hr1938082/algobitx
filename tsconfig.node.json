{
    "compilerOptions": {
        "target": "es2023",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noImplicitOverride": true,
        "paths": {
            "@algobitx/type-gen": [
                "./packages/type-gen"
            ],
            "@algobitx/config-loader": [
                "./packages/config-loader"
            ],
            "@algobitx/redis": [
                "./packages/redis"
            ],
            "@algobitx/rate-limiter": [
                "./packages/rate-limiter"
            ],
            "@algobitx/crypt": [
                "./packages/crypt"
            ],
            "@algobitx/response": [
                "./packages/response"
            ],
            "@algobitx/session": [
                "./packages/session"
            ],
            "@algobitx/url": [
                "./packages/url"
            ],
            "@algobitx/request": [
                "./packages/request"
            ],
            "@algobitx/exception": [
                "./packages/exception"
            ],
            "@algobitx/application": [
                "./packages/application"
            ],
        }
    },
    "references": [
        {
            "path": "./packages/type-gen"
        },
        {
            "path": "./packages/config-loader"
        },
        {
            "path": "./packages/redis"
        },
        {
            "path": "./packages/rate-limiter"
        },
        {
            "path": "./packages/crypt"
        },
        {
            "path": "./packages/response"
        },
        {
            "path": "./packages/session"
        },
        {
            "path": "./packages/url"
        },
        {
            "path": "./packages/request"
        },
        {
            "path": "./packages/exception"
        },
        {
            "path": "./packages/application"
        }
    ]
}