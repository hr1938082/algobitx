{
    "compilerOptions": {
        "target": "es2023",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noImplicitOverride": true,
        "paths": {
            "@algobitx/type-gen": [
                "./packages/backend/type-gen"
            ],
            "@algobitx/config-loader": [
                "./packages/backend/config-loader"
            ],
            "@algobitx/redis": [
                "./packages/backend/redis"
            ],
            "@algobitx/rate-limiter": [
                "./packages/backend/rate-limiter"
            ],
            "@algobitx/crypt": [
                "./packages/backend/crypt"
            ],
            "@algobitx/response": [
                "./packages/backend/response"
            ],
            "@algobitx/session": [
                "./packages/backend/session"
            ],
            "@algobitx/url": [
                "./packages/backend/url"
            ],
            "@algobitx/request": [
                "./packages/backend/request"
            ],
            "@algobitx/exception": [
                "./packages/backend/exception"
            ],
            "@algobitx/validator": [
                "./packages/validator"
            ],
            "@algobitx/router": [
                "./packages/backend/router"
            ],
            "@algobitx/application": [
                "./packages/backend/application"
            ],
            "@algobitx/event": [
                "./packages/backend/event"
            ],
            "@algobitx/queue-driver": [
                "./packages/backend/queue-driver"
            ],
            "@algobitx/queue-redis-driver": [
                "./packages/backend/queue-redis-driver"
            ],
            "@algobitx/queue": [
                "./packages/backend/queue"
            ],
        }
    },
    "references": [
        {
            "path": "./packages/backend/type-gen"
        },
        {
            "path": "./packages/backend/config-loader"
        },
        {
            "path": "./packages/backend/redis"
        },
        {
            "path": "./packages/backend/rate-limiter"
        },
        {
            "path": "./packages/backend/crypt"
        },
        {
            "path": "./packages/backend/response"
        },
        {
            "path": "./packages/backend/session"
        },
        {
            "path": "./packages/backend/url"
        },
        {
            "path": "./packages/backend/request"
        },
        {
            "path": "./packages/backend/exception"
        },
        {
            "path": "./packages/validator"
        },
        {
            "path": "./packages/backend/router"
        },
        {
            "path": "./packages/backend/application"
        },
        {
            "path": "./packages/backend/event"
        },
        {
            "path": "./packages/backend/queue-driver"
        },
        {
            "path": "./packages/backend/queue-redis-driver"
        },
        {
            "path": "./packages/backend/queue"
        }
    ]
}