{
  "name": "@algobitx/validator",
  "version": "1.0.0",
  "author": "Algobitx",
  "description": "Algobitx Application Library",
  "license": "UNLICENSED",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Rules/*": {
      "import": "./dist/Rules/Public/*.js",
      "require": "./dist/Rules/Public/*.js",
      "types": "./dist/Rules/Public/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist && rimraf node_modules"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}