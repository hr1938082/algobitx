{
  "name": "@algobitx/url",
  "version": "1.0.0",
  "author": "Algobitx",
  "description": "Algobitx URL Library",
  "license": "UNLICENSED",
  "files": [
    "dist/*.js",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist && rimraf node_modules"
  },
  "dependencies": {
    "@algobitx/config-loader": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}