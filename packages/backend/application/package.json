    "@bitx/crypt": "workspace:*",
    "@bitx/url": "workspace:*",
    "@bitx/validator": "workspace:*",
    "@bitx/request": "workspace:*",
    "@bitx/response": "workspace:*",
    "@bitx/router": "workspace:*",
    "@bitx/exception": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}