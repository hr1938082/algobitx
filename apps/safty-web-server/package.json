{
  "name": "@algobitx/safty-web-server",
  "version": "1.0.0",
  "author": "Algobitx",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc -b",
    "clean": "rimraf dist && rimraf node_modules && rimraf bundle",
    "bundle": "pnpm --filter @algobitx/safty-web-server --prod deploy ./bundle --legacy"
  },
  "dependencies": {
    "@algobitx/application": "workspace:*",
    "@algobitx/event": "workspace:*",
    "@algobitx/queue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}