{
  "name": "@algobitx/safty-web-server",
  "version": "1.0.0",
  "author": "Algobitx",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc -b",
    "clean": "rimraf dist && rimraf node_modules && rimraf bundle",
    "bundle": "pnpm --filter @algobitx/safty-web-server --prod deploy ./bundle --legacy"
  },
  "dependencies": {
    "@algobitx/config-loader": "workspace:*",
    "@algobitx/session": "workspace:*",
    "@algobitx/request": "workspace:*",
    "@algobitx/response": "workspace:*",
    "@algobitx/application": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}